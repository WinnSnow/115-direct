TZ=Asia/Shanghai
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
MASTER_KEY_PATH=./data/master.key
ADMIN_PORT=9527
GATEWAY_PORT=9096
PUBLIC_GATEWAY_URL=https://media.example.com
STRM_HOST_PATH=./media/115-strm
PENDING_HOST_PATH=./media/115-pending
UPLOAD_HOST_PATH=./media/115-upload
# Optional docker-compose.hardlink.yml: use a dedicated common parent directory.
MEDIA_HOST_PATH=./media
JELLYFIN_PORT=8096

# 独立CMS旧播放入口；设置中启用前返回404
CMS_LEGACY_BIND=127.0.0.1
CMS_LEGACY_PORT=19528
# 迁移时通过docker-compose.cms-migration.yml只读挂载旧STRM
CMS_STRM_HOST_PATH=/path/to/existing/cms-media
